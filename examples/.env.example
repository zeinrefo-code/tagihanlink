# Copy to examples/.env (never commit it).

# RPC to use. Aevum testnet by default; http://127.0.0.1:8545 for `make anvil` / `make fork`.
RPC_URL=https://rpc-test.qday.info

# Address of your deployed Checkout (printed by `make deploy-aevum` / `make deploy-local`).
CHECKOUT_ADDRESS=

# pay-gasless only. Use throwaway TEST wallets, never a wallet that holds real funds.
# BUYER_KEY signs (needs tUSD8, no gas). RELAYER_KEY submits (needs a little tQDAY).
BUYER_KEY=
RELAYER_KEY=

# check-setup / read-payments: the address to inspect.
ADDRESS=
