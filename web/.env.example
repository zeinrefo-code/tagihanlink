# Copy to web/.env.local (never commit it).

# Which network the app talks to: aevum | fork | local
#   aevum = QDay Aevum testnet (44005)
#   fork  = `make fork` (local copy of Aevum, chain 44005 on 127.0.0.1:8545)
#   local = `make anvil` (empty local chain 31337, uses MockUSD8)
NEXT_PUBLIC_CHAIN=aevum

# Your Checkout contract (printed by `make deploy-aevum` or `make deploy-local`).
NEXT_PUBLIC_CHECKOUT_ADDRESS=

# Optional. Enables WalletConnect (mobile wallets via QR). Free at https://cloud.reown.com
# Without it the app still works with browser-extension wallets (MetaMask, Rabby, …).
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional. Only scan events from this block onward on the Activity page (speeds it up).
NEXT_PUBLIC_DEPLOY_BLOCK=

# ---- Server only (no NEXT_PUBLIC_ prefix: never sent to the browser) ----

# Enables gasless checkout: this TEST wallet submits signed payments and pays the gas.
# Use a throwaway wallet with a little tQDAY. Never a wallet that holds anything of value.
RELAYER_PRIVATE_KEY=
